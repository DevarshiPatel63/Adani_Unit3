# Copy this file to `.env` and fill in real values. `.env` is git-ignored.

# Get a free key at https://console.groq.com/keys — needed only by agent.py.
GROQ_API_KEY=gsk_replace_me

# Any Groq-hosted model with tool use. Good defaults: openai/gpt-oss-120b, openai/gpt-oss-20b
GROQ_MODEL=openai/gpt-oss-120b

# Any public GitHub repo, in "owner/name" form. Both scripts read this.
GITHUB_REPO=langchain-ai/langgraph
