# Copy to `.env` and fill in real values. `.env` is git-ignored.

# Groq API key — used by the SPECIALIST agent (research_agent.py) to
# actually think. Free key at https://console.groq.com/keys.
GROQ_API_KEY=gsk_replace_me

# Any Groq-hosted model with tool use. Same default as Theory 11.
GROQ_MODEL=openai/gpt-oss-120b

# Where the research_agent runs. If you change these, also update the
# `url` in main_agent.py.
RESEARCH_AGENT_HOST=127.0.0.1
RESEARCH_AGENT_PORT=9999
